# ---------------- ตั้งค่า LINE Messaging API และ ImgBB ----------------
# 1. รหัสฝากรูปฟรีจากเว็บ ImgBB
IMGBB_API_KEY = "" #นำ API ของ IMBBตัวเองมาใส่

# 2. รหัสจาก LINE Developers
LINE_ACCESS_TOKEN = "" # นำรหัส access token ใน Line ของตัวเองมาใส่
LINE_USER_ID = ""  # รหัสประจำตัวคุณ เพื่อให้บอททักหาถูกคน

def send_line_alert(image):
    """ฟังก์ชันอัปโหลดรูปขึ้น ImgBB และส่งลิงก์เข้า LINE (ทำงานเบื้องหลัง)"""
    try:
        # 1. แปลงรูปและอัปโหลดขึ้น ImgBB
        _, img_encoded = cv2.imencode('.jpg', image)
        imgbb_url = "https://api.imgbb.com/1/upload"
        imgbb_payload = {"key": IMGBB_API_KEY}
        imgbb_files = {"image": img_encoded.tobytes()}
        
        # ใส่ timeout=10 ป้องกันโปรแกรมค้างเวลาเน็ตมีปัญหา
        res = requests.post(imgbb_url, data=imgbb_payload, files=imgbb_files, timeout=10)
        image_url = res.json()["data"]["url"]  # ได้ลิงก์รูปมาแล้ว

        # 2. นำลิงก์รูปไปส่งเข้า LINE Messaging API
        line_url = "https://api.line.me/v2/bot/message/push"
        headers = {
            "Content-Type": "application/json",
            "Authorization": f"Bearer {LINE_ACCESS_TOKEN}"
        }
        data = {
            "to": LINE_USER_ID,
            "messages": [
                {
                    "type": "text",
                    "text": "⚠️ แจ้งเตือน: ตรวจพบการล้ม!"
                },
                {
                    "type": "image",
                    "originalContentUrl": image_url,
                    "previewImageUrl": image_url
                }
            ]
        }
        requests.post(line_url, headers=headers, json=data, timeout=10)
        print("✅ ส่งรูปแจ้งเตือนเข้า LINE สำเร็จ!")
    except Exception as e:
        print(f"❌ ส่ง LINE ไม่สำเร็จ: {e}")
